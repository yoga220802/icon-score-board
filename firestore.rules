rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && userRole() == 'admin';
    }

    function isJudge() {
      return request.auth != null && userRole() == 'judge';
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();

      match /assessments/{assessmentId} {
        allow read: if true;
        allow create: if isJudge() && request.resource.data.judge_id == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /questions_phase1/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /phase2_topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /game_state/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
